VAULTCHAT_PORT=8787
VAULTCHAT_JWT_SECRET=replace-with-at-least-32-random-characters
# Separate pepper for optional recovery-email HMACs. Use a different secret than JWT in production.
VAULTCHAT_EMAIL_HASH_SECRET=replace-with-another-32-random-characters
VAULTCHAT_CORS_ORIGIN=https://chat.example.org
VAULTCHAT_CLIENT_ORIGINS=https://chat.example.org
VAULTCHAT_CONNECT_ORIGINS=https://chat.example.org

# Durable directory (users/groups/prekeys). Without this it is RAM-only and
# wiped on every restart/deploy. Point it at a persistent disk/volume.
VAULTCHAT_STATE_FILE=/data/vaultchat-state.json
# At-rest encryption of the directory (AES-256-GCM). 32 bytes as 64 hex chars
# or base64. Generate: openssl rand -base64 32
# With this set, the state file and any backup contain no plaintext usernames,
# identity keys or group metadata. Keep it as stable as JWT_SECRET: losing it
# makes an existing encrypted state file unreadable.
VAULTCHAT_STATE_KEY=replace-with-base64-or-hex-of-32-random-bytes

# Product default: invite-only launch. Use closed during private testing.
VAULTCHAT_REGISTRATION_MODE=invite
VAULTCHAT_INVITE_CODES=replace-with-long-random-invite-code
# Prefer hashes for real deployments:
# VAULTCHAT_INVITE_CODE_HASHES=<sha256-hex-of-invite-code>
# VAULTCHAT_ALLOW_OPEN_REGISTRATION=1 is required if mode=open in production.

# For IP privacy in calls, run a real TURN service and set:
VAULTCHAT_FORCE_RELAY=1
VAULTCHAT_TURN_URL=turns:turn.example.org:5349
VAULTCHAT_TURN_USER=replace-me
VAULTCHAT_TURN_PASS=replace-me
