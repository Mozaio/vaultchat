{
  "name": "Umbra — private messenger",
  "short_name": "Umbra",
  "description": "End-to-end encrypted messaging. The server sees nothing — your conversations stay yours.",
  "lang": "en",
  "dir": "auto",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#1a130e",
  "theme_color": "#c75b39",
  "categories": ["social", "communication", "productivity"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
